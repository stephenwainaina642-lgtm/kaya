NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://kaya_app:kaya_app_pw@localhost:5432/kaya
DATABASE_ADMIN_URL=postgres://kaya:kaya_admin_pw@localhost:5432/kaya
JWT_ACCESS_SECRET=dev-access-secret-change-me
PLATFORM_JWT_SECRET=dev-platform-secret-change-me
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Optional — AI features (lead scoring, drafted messages, summaries,
# next-best-action suggestions) are disabled gracefully when this is unset.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional — password-reset emails are sent through Resend (https://resend.com).
# Without a key the reset link is only printed to the server log (dev) and
# no email goes out. MAIL_FROM must be on a domain verified in Resend for
# real delivery; the default is Resend's shared sandbox sender.
RESEND_API_KEY=
MAIL_FROM=Kaya <onboarding@resend.dev>
# Public URL of the web app, used in email links (Render sets RENDER_EXTERNAL_URL automatically).
APP_URL=
# Optional but REQUIRED for production — durable file storage (logos, documents)
# in any S3-compatible bucket, e.g. Cloudflare R2. Without it files live on the
# server's local disk, which hosts like Render wipe on every deploy.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
